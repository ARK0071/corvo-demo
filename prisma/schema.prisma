// =============================================================================
// TASK MANAGEMENT - Assignment, tasks, playbooks, comments, notifications
// =============================================================================

model Task {
  id              String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  portProfileId   String         @map("port_profile_id") @db.Uuid
  awardId         String?        @map("award_id") @db.Uuid
  pipelineGrantId String?        @map("pipeline_grant_id") @db.Uuid
  title           String         @db.VarChar(500)
  description     String         @default("")
  status          String         @default("not_started") @db.VarChar(30)
  priority        String         @default("medium") @db.VarChar(20)
  startDate       DateTime?      @map("start_date") @db.Date
  dueDate         DateTime?      @map("due_date") @db.Date
  assigneeId      String?        @map("assignee_id") @db.Uuid
  area            String?        @db.VarChar(50)
  phase           String?        @db.VarChar(30)
  parentTaskId    String?        @map("parent_task_id") @db.Uuid
  source          String         @default("manual") @db.VarChar(20)
  deliverableRef  String?        @map("deliverable_ref") @db.VarChar(500)
  deliverableType String?        @map("deliverable_type") @db.VarChar(50)
  deliverableId   String?        @map("deliverable_id") @db.Uuid
  sortOrder       Int            @default(0) @map("sort_order")
  flagged         Boolean        @default(false)
  createdBy       String?        @map("created_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  portProfile     PortProfile    @relation(fields: [portProfileId], references: [id], onDelete: Cascade)
  award           Award?         @relation(fields: [awardId], references: [id], onDelete: Cascade)
  pipelineGrant   PipelineGrant? @relation(fields: [pipelineGrantId], references: [id], onDelete: Cascade)
  assignee        User?          @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator         User?          @relation("TaskCreator", fields: [createdBy], references: [id])
  parentTask      Task?          @relation("Subtasks", fields: [parentTaskId], references: [id])
  subtasks        Task[]         @relation("Subtasks")
  comments        TaskComment[]

  @@index([portProfileId])
  @@index([awardId])
  @@index([pipelineGrantId])
  @@index([assigneeId])
  @@index([status])
  @@index([phase])
  @@index([dueDate])
  @@index([parentTaskId])
  @@map("tasks")
}

model GrantAssignment {
  id            String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
