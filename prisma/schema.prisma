  status         String             @default("requested") @db.VarChar(20)
  requestedDate  DateTime           @default(now()) @map("requested_date")
  approvedDate   DateTime?          @map("approved_date")
  award          DemoAward          @relation(fields: [awardId], references: [id], onDelete: Cascade)
  fromCategory   DemoBudgetCategory @relation("DemoFromCategory", fields: [fromCategoryId], references: [id], onDelete: Cascade)
  toCategory     DemoBudgetCategory @relation("DemoToCategory", fields: [toCategoryId], references: [id], onDelete: Cascade)

  @@index([portId])
  @@index([awardId])
  @@map("demo_budget_modifications")
}

model DemoGrantDraft {
  id                   String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  portId               String          @map("port_id") @db.VarChar(100)
  portProfileId        String          @map("port_profile_id") @db.Uuid
  grantId              String          @map("grant_id") @db.VarChar(50)
  grantProgram         String          @map("grant_program") @db.VarChar(255)
  status               String          @default("researching") @db.VarChar(20)
  researchData         Json?           @map("research_data")
  userGuidance         Json?           @map("user_guidance")
  sections             Json            @default("[]")
  overallCompleteness  Int             @default(0) @map("overall_completeness")
  attachmentsChecklist Json            @default("[]") @map("attachments_checklist")
  generatedAt          DateTime?       @map("generated_at")
  lastEditedAt         DateTime?       @map("last_edited_at")
  lastEditedById       String?         @map("last_edited_by_id") @db.VarChar(100)
  lastEditedByName     String?         @map("last_edited_by_name") @db.VarChar(255)
  createdById          String?         @map("created_by_id") @db.VarChar(100)
  createdByName        String?         @map("created_by_name") @db.VarChar(255)
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  portProfile          DemoPortProfile @relation(fields: [portProfileId], references: [id], onDelete: Cascade)
  versions             DemoGrantDraftVersion[]

  @@unique([grantId, portProfileId, portId])
  @@index([portId])
  @@index([portProfileId])
  @@map("demo_grant_drafts")
}

model DemoGrantDraftVersion {
  id                   String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  draftId              String         @map("draft_id") @db.Uuid
  versionNumber        Int            @map("version_number")
  sections             Json           @default("[]")
  overallCompleteness  Int            @default(0) @map("overall_completeness")
  editedById           String?        @map("edited_by_id") @db.VarChar(100)
  editedByName         String?        @map("edited_by_name") @db.VarChar(255)
  editSummary          String         @default("") @map("edit_summary")
  createdAt            DateTime       @default(now()) @map("created_at")
  draft                DemoGrantDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, versionNumber])
  @@index([draftId])
  @@map("demo_grant_draft_versions")
}

// =============================================================================
// SCHEDULED REPORTS - Report tracking for awards
// =============================================================================

model DemoScheduledReport {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  portId           String    @map("port_id") @db.VarChar(100)
  awardId          String    @map("award_id") @db.Uuid
  type             String    @db.VarChar(50)
  title            String    @db.VarChar(255)
  dueDate          DateTime  @map("due_date") @db.Date
  periodStart      DateTime  @map("period_start") @db.Date
  periodEnd        DateTime  @map("period_end") @db.Date
  status           String    @default("upcoming") @db.VarChar(50)
  submittedDate    DateTime? @map("submitted_date") @db.Date
  notes            String    @default("")
  generatedContent Json?     @map("generated_content")
  narrativeDraft   String?   @map("narrative_draft")
  drafterUserId    String?   @map("drafter_user_id") @db.Uuid
  reviewerUserId   String?   @map("reviewer_user_id") @db.Uuid
  reviewedAt       DateTime? @map("reviewed_at")
  reviewNotes      String?   @map("review_notes")
  certificationId  String?   @map("certification_id") @db.Uuid
  contentLockedAt  DateTime? @map("content_locked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
